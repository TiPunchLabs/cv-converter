# .envrc - Crée et active le venv automatiquement
if [[ ! -d .venv ]]; then
    uv venv
fi
source .venv/bin/activate

# Synchroniser les dépendances si uv.lock existe
if [[ -f uv.lock ]]; then
    uv sync
fi

# Variables Terraform
export TF_VAR_github_token=$(pass github/terraform-token)
export TF_VAR_github_owner="TiPunchLabs"
